{
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "lib": ["esnext", "dom"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "#/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "types": ["vite/client"]
  }
}
